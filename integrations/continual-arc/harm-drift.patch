new file mode 100644
index 0000000..9161e08
--- /dev/null
+++ b/src/continual_arc/stale.py
@@ -0,0 +1,245 @@
+"""The stale-state cost: what a learner pays for trusting what it kept once the rule has changed.
+
+The two frozen tests read what a learner's state saves (:func:`continual_arc.metrics.transfer`). Nothing reads what
+that state costs when it is wrong, and a learner that replays whatever it stored under a task's name looks the same
+on both tests as one that checks first. This module reads the difference, in two modes, through the plug-in
+interface (:mod:`continual_arc.addons`). The environment serves and charges every instance as it always does, and
+no benchmark slot, record or measure changes.
+
+After the stream (:class:`StaleAliasPlugin`). Once the last benchmark instance has ended, the plug-in asks for
+auxiliary episodes in pairs. Both episodes of a pair are the same fresh instance of a task the run never served,
+drawn from the stream's own generators. In the *swapped* episode the learner is shown that instance under the alias
+of a task it met in the stream, so whatever it kept under the alias is now wrong. In the *control* episode it is
+shown the same instance under the task's own alias, which it has never seen. The stale-state cost is the budget used
+on the swapped episodes less the budget used on the controls (:func:`stale_state_cost`).
+
+Inside the stream (:func:`drift_schedule`, :class:`DriftAliasPlugin`). A schedule is rebuilt so that some tasks'
+slots, from a chosen visit on, are slots of a task the stream never serves, and the plug-in shows those slots under
+the alias of the task they replaced: the task's rule changes at that visit and stays changed. The control is the
+same schedule played without the plug-in, where the new rule arrives under a name of its own (:func:`drift_cost`).
+
+Both plug-ins change one thing, the task id of the observation the learner's alias is drawn from. Neither changes
+an action or a feedback.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from collections.abc import Sequence
+from dataclasses import replace
+from typing import Any
+
+from continual_arc.addons import BasePlugin, EpisodeRequest, PluginContext, PluginResponse
+from continual_arc.configs import select_tasks
+from continual_arc.env import EnvConfig, InstanceRecord, Observation
+from continual_arc.metrics import transfer
+from continual_arc.schedule import PHASE_SEEN_TEST, PHASE_STREAM, TEST_SEEN, Schedule
+from continual_arc.seeds import derive_seed
+from continual_arc.tasks import SOURCE_ARCGEN, SOURCE_REARC
+
+PHASE_STALE_ALIAS = "stale-alias"
+ARM_SWAPPED = "swapped"
+ARM_CONTROL = "control"
+
+
+def generator_pool(source: str) -> list[str]:
+    """Every task ``source`` draws fresh instances of: where a rule the learner never met comes from."""
+    if source == SOURCE_REARC:
+        from continual_arc.rearc import ReArc
+
+        return list(ReArc().task_ids)
+    if source == SOURCE_ARCGEN:
+        from continual_arc.arcgen import pool
+
+        return pool()
+    raise ValueError(f"source {source!r} has no generators known here: name the unseen tasks (donor_tasks)")
+
+
+def _pairs(schedule: Schedule, seen: list[str], donor_tasks: Sequence[str] | None, n: int | None, seed: int,
+           label: str) -> list[tuple[str, str]]:
+    """``n`` (seen task, unseen task) pairs, a seeded draw of each side: the unseen tasks from ``donor_tasks``, or
+    from the generators of the seen tasks' source, less every task of ``schedule``."""
+    if not seen:
+        raise ValueError(f"{schedule.name} has no task to change the rule of")
+    pool = generator_pool(schedule.sources[seen[0]]) if donor_tasks is None else donor_tasks
+    unseen = sorted(set(pool) - set(schedule.sources))
+    most = min(len(seen), len(unseen))
+    n = most if n is None else n
+    if not 1 <= n <= most:
+        raise ValueError(f"asked for {n} pairs of {len(seen)} seen and {len(unseen)} unseen tasks")
+    return list(zip(select_tasks(seen, n, seed, f"{label}-seen"), select_tasks(unseen, n, seed, f"{label}-unseen"),
+                    strict=True))
+
+
+def stale_state_cost(swapped: Sequence[InstanceRecord], control: Sequence[InstanceRecord], config: EnvConfig,
+                     reps: int = 2000, seed: int = 0) -> dict:
+    """What trusting stale state costs: the budget used on ``swapped`` (instances shown under a name whose rule
+    the learner kept, and which is now another rule) less the budget used on ``control`` (the same instances
+    under a name it never saw), in points of the budget; positive is a cost. Instances are matched by task and
+    instance seed, and the 95 percent interval is a bootstrap over tasks. The figures are
+    :func:`continual_arc.metrics.transfer`'s, with the control in the run's place and the swapped play in the
+    reset's, so they are read as the frozen tests' T is. ``extra_cost`` is the same difference per instance in
+    charges, one being one wrong attempt or one demonstration. Zero says the learner pays nothing for what it kept;
+    it does not say it kept nothing."""
+    control, swapped = ([replace(r, phase=PHASE_SEEN_TEST) for r in records] for records in (control, swapped))
+    read = transfer(control, swapped, config, test=TEST_SEEN, reps=reps, seed=seed)
+    if not read["n"]:
+        return {"n": 0, "stale_state_cost": None}
+    return {
+        "n": read["n"],
+        "tasks": read["tasks"],
+        "swapped_budget": read["reset_budget"],
+        "control_budget": read["run_budget"],
+        "stale_state_cost": read["transfer"],
+        "ci95": read["ci95"],
+        "se": read["se"],
+        "extra_cost": read["transfer"] * config.max_cost / 100.0,
+        "solved": {ARM_SWAPPED: read["solved"]["reset"], ARM_CONTROL: read["solved"]["run"]},
+        "reps": reps,
+    }
+
+
+class StaleAliasPlugin(BasePlugin):
+    """After the stream, serve fresh instances of unseen tasks twice each: once under the alias of a task the
+    learner met (*swapped*) and once under the unseen task's own (*control*), and read the difference
+    (``summary()``, :func:`stale_state_cost`).
+
+    The host schedule is a stream, or a seen test played one instance at a time (``--width 1``); its tasks are
+    the ones whose aliases are swapped. The episodes are served as the host's own instances are: when every slot
+    of the host is marked ``reset_before`` so is every episode, which on a frozen test restores the learner's
+    state at the end of the stream and on a reset stream wipes it; on a plain stream the learner goes on
+    learning. So that an episode cannot teach its pair's other half the same thing on every pair, the swapped
+    episode comes first on even pairs and second on odd ones, and each alias and each unseen task is used once.
+
+    ``pairs`` is how many (every seen task by default, as far as the unseen tasks last), ``donor_tasks`` the
+    unseen tasks to draw from (by default the generators of the stream's source, less the host's tasks),
+    ``seed`` the draw's (the schedule's by default) and ``reps`` the bootstrap's resamples. The learner is shown
+    an episode as it is shown any instance: no episode type, plug-in name or metadata. The plug-in runs after
+    every other, so the others see each slot as the environment serves it."""
+
+    name = "stale_alias"
+    priority = 1000
+
+    def __init__(self, pairs: int | None = None, donor_tasks: Sequence[str] | None = None, seed: int | None = None,
+                 reps: int = 2000) -> None:
+        self.pairs = pairs
+        self.donor_tasks = donor_tasks
+        self.seed = seed
+        self.reps = reps
+        self._requests: tuple[EpisodeRequest, ...] = ()
+        self._summary: dict[str, Any] = {}
+
+    def on_run_start(self, context: PluginContext) -> PluginResponse | None:
+        schedule = context.schedule
+        if not isinstance(context.config, EnvConfig):
+            raise TypeError("the stale-alias episodes are grid instances: the ARC-AGI-3 environment serves none")
+        seen = sorted({s.task_id for s in schedule.slots if s.phase in (PHASE_STREAM, PHASE_SEEN_TEST)})
+        seed = schedule.seed if self.seed is None else self.seed
+        as_host = bool(schedule.slots) and all(s.reset_before for s in schedule.slots)
+        requests = []
+        for i, (alias_of, unseen) in enumerate(_pairs(schedule, seen, self.donor_tasks, self.pairs, seed,
+                                                      PHASE_STALE_ALIAS)):
+            for arm in (ARM_SWAPPED, ARM_CONTROL) if i % 2 == 0 else (ARM_CONTROL, ARM_SWAPPED):
+                requests.append(EpisodeRequest(
+                    task_id=unseen,
+                    source=schedule.sources[alias_of],
+                    instance_seed=derive_seed(seed, PHASE_STALE_ALIAS, i),
+                    phase=PHASE_STALE_ALIAS,
+                    reset_before=as_host,
+                    plugin=self.name,
+                    metadata={"arm": arm, "pair": i, "alias_of": alias_of},
+                ))
+        self._requests = tuple(requests)
+        return None
+
+    def on_observation(self, observation: Observation, context: PluginContext) -> PluginResponse | None:
+        del context
+        if observation.plugin != self.name:
+            return None
+        meta = observation.metadata
+        task_id = meta["alias_of"] if meta["arm"] == ARM_SWAPPED else observation.task_id
+        return PluginResponse(observation=replace(observation, task_id=task_id, episode_type="benchmark",
+                                                  plugin=None, metadata={}))
+
+    def on_episode_end(self, record: InstanceRecord, context: PluginContext) -> PluginResponse | None:
+        # the clock counts the benchmark episodes that ended before this one
+        if record.episode_type == "benchmark" and context.benchmark_clock == len(context.schedule) - 1:
+            return PluginResponse(episode_requests=self._requests)
+        return None
+
+    def on_run_end(self, records: list[InstanceRecord], context: PluginContext) -> None:
+        arms = {arm: [r for r in records if r.plugin == self.name and r.metadata.get("arm") == arm]
+                for arm in (ARM_SWAPPED, ARM_CONTROL)}
+        self._summary = stale_state_cost(arms[ARM_SWAPPED], arms[ARM_CONTROL], context.config, reps=self.reps)
+
+    def summary(self) -> dict[str, Any]:
+        return dict(self._summary)
+
+
+def drift_schedule(schedule: Schedule, at_visit: int = 4, tasks: int | None = None,
+                   donor_tasks: Sequence[str] | None = None, seed: int | None = None) -> Schedule:
+    """``schedule`` with a rule that changes inside its stream: for ``tasks`` of the stream's tasks (all that are
+    met more than ``at_visit`` times by default), every stream slot from the task's visit ``at_visit`` on (counted
+    from 0, so the default is its fifth) becomes a slot of a task the schedule never serves, at the same instance
+    seed and in the same place. The unseen tasks are drawn as :class:`StaleAliasPlugin` draws them. The schedule's
+    ``meta["drift"]`` names the visit and, for each new task, the task it replaced (``shown_as``), which is the
+    alias :class:`DriftAliasPlugin` shows it under; :func:`continual_arc.configs.protocol_of` lists the change as a
+    deviation, so a drifted stream is never read as a canonical one."""
+    if at_visit < 1:
+        raise ValueError("at_visit must be >= 1: a rule changes only after its task has been met")
+    visits = Counter(s.task_id for s in schedule.slots if s.phase == PHASE_STREAM)
+    seen = sorted(t for t, n in visits.items() if n > at_visit)
+    seed = schedule.seed if seed is None else seed
+    becomes = dict(_pairs(schedule, seen, donor_tasks, tasks, seed, "drift"))
+    met: Counter[str] = Counter()
+    slots = []
+    for slot in schedule.slots:
+        if slot.phase == PHASE_STREAM and slot.task_id in becomes:
+            met[slot.task_id] += 1
+            if met[slot.task_id] > at_visit:
+                slot = replace(slot, task_id=becomes[slot.task_id])
+        slots.append(slot)
+    return Schedule(
+        name=f"{schedule.name}-drift{at_visit}",
+        seed=schedule.seed,
+        slots=slots,
+        sources={**schedule.sources, **{new: schedule.sources[old] for old, new in becomes.items()}},
+        meta={**schedule.meta, "drift": {"at_visit": at_visit,
+                                         "shown_as": {new: old for old, new in sorted(becomes.items())}}},
+        users=schedule.users,
+    )
+
+
+class DriftAliasPlugin(BasePlugin):
+    """Shows every changed slot of a :func:`drift_schedule` under the alias of the task it replaced, so the
+    learner meets a new rule under a name it knows. Without it the same schedule is the control: the new rule
+    under a name of its own."""
+
+    name = "drift_alias"
+    priority = 1000
+
+    def on_observation(self, observation: Observation, context: PluginContext) -> PluginResponse | None:
+        shown_as = (context.schedule.meta.get("drift") or {}).get("shown_as", {})
+        if observation.episode_type != "benchmark" or observation.task_id not in shown_as:
+            return None
+        return PluginResponse(observation=replace(observation, task_id=shown_as[observation.task_id]))
+
+
+def drift_cost(run_records: Sequence[InstanceRecord], control_records: Sequence[InstanceRecord], schedule: Schedule,
+               config: EnvConfig, reps: int = 2000, seed: int = 0) -> dict:
+    """The stale-state cost inside a :func:`drift_schedule`'s stream: :func:`stale_state_cost` over its changed
+    slots, ``run_records`` being a learner's play of ``schedule`` under :class:`DriftAliasPlugin` and
+    ``control_records`` the same learner's play of it without. ``by_visit`` is the same cost at each visit since
+    the change, 0 being the visit the rule changed at: a learner that repairs what it kept pays at 0 and not
+    after, and one that never does pays at every visit."""
+    changed = schedule.meta["drift"]["shown_as"]
+    run, control = ([r for r in records if r.episode_type == "benchmark" and r.task_id in changed]
+                    for records in (run_records, control_records))
+    out = stale_state_cost(run, control, config, reps=reps, seed=seed)
+    out["by_visit"] = [
+        {"visit": visit, **{k: v for k, v in stale_state_cost(
+            [r for r in run if r.exposure_index == visit], [r for r in control if r.exposure_index == visit],
+            config, reps=0).items() if k in ("n", "swapped_budget", "control_budget", "stale_state_cost")}}
+        for visit in sorted({r.exposure_index for r in run})
+    ]
+    return out
