+"""The stale-state cost (continual_arc.stale), read on three learners with no model: one that keeps nothing, one that
+runs the program it kept for a name and drops it at the first wrong answer, and one that trusts what it kept."""
+
+import json
+
+import pytest
+
+from continual_arc.aliases import SALT_FILE, TaskAliases
+from continual_arc.configs import protocol_of
+from continual_arc.env import EnvConfig, SubmitFeedback
+from continual_arc.runner import run
+from continual_arc.schedule import (
+    PHASE_SEEN_TEST,
+    Schedule,
+    Slot,
+    sequential_params,
+    stream_schedule,
+)
+from continual_arc.stale import (
+    ARM_CONTROL,
+    ARM_SWAPPED,
+    PHASE_STALE_ALIAS,
+    DriftAliasPlugin,
+    StaleAliasPlugin,
+    drift_cost,
+    drift_schedule,
+    stale_state_cost,
+)
+from continual_arc.tasks import TaskRegistry
+from continual_arc.testing import FakeSource, ShiftMemoryLearner
+
+WRONG = 100 / EnvConfig().max_cost   # one wrong attempt or one demonstration, in points of the budget
+
+
+class Rules(FakeSource):
+    """A FakeSource whose tasks all have different rules, so a name that changes task always changes rule."""
+
+    def shift(self, task_id):
+        return 1 + self._ids.index(task_id)
+
+
+class Forgetful(ShiftMemoryLearner):
+    """Keeps nothing: it buys a demonstration on every instance."""
+
+    def end_round(self):
+        self.memory.clear()
+
+
+class Repairing(ShiftMemoryLearner):
+    """Runs what it kept for a name first, and at a wrong answer drops it and buys a demonstration."""
+
+    def observe(self, obs, action, feedback):
+        super().observe(obs, action, feedback)
+        if isinstance(feedback, SubmitFeedback) and not feedback.correct:
+            self.memory.pop(obs.task_id, None)
+
+
+Trusting = ShiftMemoryLearner   # answers from what it kept for a name until the instance fails
+LEARNERS = (Forgetful, Repairing, Trusting)
+
+
+class Restored(Repairing):
+    """A learner frozen at the end of its stream: its reset restores what it kept then, as a frozen test asks."""
+
+    def __init__(self, kept):
+        super().__init__()
+        self.kept = dict(kept)
+        self.reset()
+
+    def reset(self):
+        self.memory = dict(self.kept)
+
+
+class Shown(Repairing):
+    """A Repairing learner that keeps the first observation of every instance."""
+
+    def __init__(self):
+        super().__init__()
+        self.shown = []
+
+    def act(self, obs):
+        if obs.is_fresh:
+            self.shown.append(obs)
+        return super().act(obs)
+
+
+@pytest.fixture
+def rules():
+    return Rules(n_tasks=8)
+
+
+@pytest.fixture
+def registry(rules):
+    return TaskRegistry({rules.name: rules})
+
+
+@pytest.fixture
+def seen(rules):
+    return rules.task_ids()[:4]
+
+
+@pytest.fixture
+def unseen(rules):
+    return rules.task_ids()[4:]
+
+
+def stream_of(seen, visits=3, seed=0):
+    return stream_schedule(seen, len(seen) * visits, seed=seed, source="fake", params=sequential_params(visits),
+                           order="sequential")
+
+
+def played(result, arm):
+    return [r for r in result.records if r.plugin == "stale_alias" and r.metadata["arm"] == arm]
+
+
+def read(result):
+    return result.summary["plugins"]["plugins"]["stale_alias"]
+
+
+def test_a_learner_pays_for_what_it_trusts(registry, seen, unseen):
+    results = {cls: run(cls(), stream_of(seen), registry=registry, plugins=[StaleAliasPlugin(donor_tasks=unseen)])
+               for cls in LEARNERS}
+    for result in results.values():   # the same episodes for every learner: each unseen task once in each arm
+        assert sorted(r.task_id for r in played(result, ARM_SWAPPED)) == unseen
+        assert sorted(r.task_id for r in played(result, ARM_CONTROL)) == unseen
+        assert all(r.cost == 1 and r.demo_requests == 1 for r in played(result, ARM_CONTROL))
+
+    nothing, repaired, trusted = (read(results[cls]) for cls in LEARNERS)
+    assert nothing["stale_state_cost"] == 0 and nothing["ci95"] == [0, 0]
+    # the program it kept is wrong once, on every episode, and the demonstration it then buys the control buys too
+    assert all(r.wrong_attempts == 1 and r.solved for r in played(results[Repairing], ARM_SWAPPED))
+    assert repaired["extra_cost"] == 1 and repaired["stale_state_cost"] == WRONG and repaired["ci95"] == [WRONG, WRONG]
+    assert repaired["swapped_budget"] == 2 * WRONG and repaired["control_budget"] == WRONG
+    # it never doubts what it kept, so every swapped episode costs the whole budget
+    assert not any(r.solved for r in played(results[Trusting], ARM_SWAPPED))
+    assert trusted["swapped_budget"] == 100 and trusted["extra_cost"] == 15
+    assert trusted["solved"] == {ARM_SWAPPED: 0, ARM_CONTROL: 1}
+    assert nothing["stale_state_cost"] < repaired["stale_state_cost"] < trusted["stale_state_cost"]
+    assert all(r["n"] == r["tasks"] == 4 for r in (nothing, repaired, trusted))
+
+
+def test_the_benchmark_reads_the_same_with_the_plugin_and_without(registry, seen, unseen):
+    stream = stream_of(seen)
+    alone = run(Trusting(), stream, registry=registry)
+    probed = run(Trusting(), stream, registry=registry, plugins=[StaleAliasPlugin(donor_tasks=unseen)])
+
+    def benchmark(result):
+        return [{k: v for k, v in r.to_json().items() if k != "resources"}
+                for r in result.records if r.episode_type == "benchmark"]
+
+    assert benchmark(probed) == benchmark(alone) and len(probed.records) == len(alone.records) + 8
+    for block in ("benchmark", "stream", "seen_test", "held_out_test", "epilogue", "acquisition", "retention_by_gap",
+                  "cost_by_exposure", "checkpoints", "per_task", "protocol"):
+        assert probed.summary[block] == alone.summary[block]
+    assert probed.summary["addons"]["n"] == 8 and set(probed.summary["by_phase"]) == {"stream", PHASE_STALE_ALIAS}
+
+
+def test_an_episode_is_shown_under_a_seen_name_or_a_new_one_and_as_any_instance(registry, seen, unseen, tmp_path):
+    learner = Shown()
+    result = run(learner, stream_of(seen), out_dir=tmp_path / "run", registry=registry,
+                 plugins=[StaleAliasPlugin(donor_tasks=unseen)])
+    aliases = TaskAliases.for_run(tmp_path / "run")
+    met = {aliases.alias(t) for t in seen}
+    episodes = [r for r in result.records if r.plugin == "stale_alias"]
+    for record, obs in zip(episodes, learner.shown[-len(episodes):], strict=True):
+        swapped = record.metadata["arm"] == ARM_SWAPPED
+        assert obs.task_id == aliases.alias(record.metadata["alias_of"] if swapped else record.task_id)
+        assert (obs.task_id in met) == swapped
+        assert (obs.episode_type, obs.plugin, obs.metadata) == ("benchmark", None, {})
+    assert len({o.task_id for o in learner.shown[-len(episodes):]}) == 8   # every name once
+    # the records keep what the environment served, and say which name it was shown under
+    assert all(r.episode_type == "addon" and r.phase == PHASE_STALE_ALIAS and r.task_id in unseen for r in episodes)
+    assert [r.metadata["arm"] for r in episodes] == [ARM_SWAPPED, ARM_CONTROL, ARM_CONTROL, ARM_SWAPPED] * 2
+
+
+def test_the_episodes_and_their_reading_are_a_function_of_the_seed(registry, seen, unseen):
+    def episodes(seed, donors=unseen, **kw):
+        result = run(Repairing(), stream_of(seen, seed=seed), registry=registry,
+                     plugins=[StaleAliasPlugin(donor_tasks=donors, **kw)])
+        return [(r.task_id, r.instance_seed, r.metadata) for r in result.records if r.plugin], json.dumps(read(result))
+
+    assert episodes(0) == episodes(0)
+    assert episodes(0, donors=unseen[::-1]) == episodes(0)   # the draw is from the tasks sorted
+    assert {seed for _, seed, _ in episodes(0)[0]}.isdisjoint(seed for _, seed, _ in episodes(1)[0])
+    assert len(episodes(0, pairs=2)[0]) == 4
+
+
+def test_a_frozen_test_serves_every_episode_from_the_end_of_the_stream(registry, seen, unseen, tmp_path):
+    learner = Repairing()
+    stream = stream_of(seen)
+    run(learner, stream, out_dir=tmp_path / "stream", registry=registry)
+    test = Schedule(name="seen-test", seed=0, sources=dict(stream.sources),
+                    slots=[Slot(t, 100 + i, PHASE_SEEN_TEST, reset_before=True) for i, t in enumerate(seen)])
+    (tmp_path / "test").mkdir()   # the test is played under the stream's names
+    (tmp_path / "test" / SALT_FILE).write_text((tmp_path / "stream" / SALT_FILE).read_text())
+    frozen = Restored(learner.memory)
+    result = run(frozen, test, out_dir=tmp_path / "test", registry=registry,
+                 plugins=[StaleAliasPlugin(donor_tasks=unseen)])
+    assert all(r.cost == 0 for r in result.records if r.episode_type == "benchmark")
+    assert all(r.reset_before for r in result.records)
+    assert {r.cost for r in played(result, ARM_SWAPPED)} == {2} and {r.cost for r in played(result, ARM_CONTROL)} == {1}
+    assert read(result)["extra_cost"] == 1
+    frozen.reset()
+    assert frozen.memory == frozen.kept
+
+
+def test_a_learner_wiped_before_every_instance_pays_nothing(registry, seen, unseen):
+    result = run(Trusting(), stream_of(seen).reset_each(), registry=registry,
+                 plugins=[StaleAliasPlugin(donor_tasks=unseen)])
+    assert all(r.reset_before and r.cost == 1 for r in result.records if r.plugin)
+    assert read(result)["stale_state_cost"] == 0
+
+
+def test_the_plugin_needs_met_tasks_and_unmet_ones(registry, seen, unseen):
+    stream = stream_of(seen)
+    with pytest.raises(ValueError, match="4 seen and 0 unseen"):
+        run(Trusting(), stream, registry=registry, plugins=[StaleAliasPlugin(donor_tasks=seen)])
+    with pytest.raises(ValueError, match="asked for 5 pairs"):
+        run(Trusting(), stream, registry=registry, plugins=[StaleAliasPlugin(donor_tasks=unseen, pairs=5)])
+    with pytest.raises(ValueError, match="no generators known here"):
+        run(Trusting(), stream, registry=registry, plugins=[StaleAliasPlugin()])
+    assert stale_state_cost([], [], EnvConfig()) == {"n": 0, "stale_state_cost": None}
+
+
+def test_drift_changes_a_rule_from_a_visit_on_and_is_never_canonical(seen, unseen):
+    stream = stream_of(seen, visits=6)
+    drifted = drift_schedule(stream, at_visit=4, donor_tasks=unseen)
+    shown_as = drifted.meta["drift"]["shown_as"]
+    assert sorted(shown_as) == unseen and sorted(shown_as.values()) == seen
+    visit = dict.fromkeys(seen, 0)
+    for was, now in zip(stream.slots, drifted.slots, strict=True):
+        if visit[was.task_id] < 4:
+            assert now == was
+        else:   # the same place, phase and instance seed, another task
+            assert shown_as[now.task_id] == was.task_id and now.instance_seed == was.instance_seed
+        visit[was.task_id] += 1
+    assert all(drifted.sources[t] == "fake" for t in unseen)
+    assert drifted.name == "sequential-drift4" and drift_schedule(stream, donor_tasks=unseen).slots == drifted.slots
+    assert "the rule of 4 tasks changes at visit 4" in protocol_of(drifted)["deviations"]
+    assert not any("changes at visit" in d for d in protocol_of(stream)["deviations"])
+    assert len(drift_schedule(stream, at_visit=4, tasks=1, donor_tasks=unseen).meta["drift"]["shown_as"]) == 1
+    with pytest.raises(ValueError, match="no task to change the rule of"):
+        drift_schedule(stream, at_visit=6, donor_tasks=unseen)
+    with pytest.raises(ValueError, match="after its task has been met"):
+        drift_schedule(stream, at_visit=0, donor_tasks=unseen)
+
+
+def test_inside_the_stream_a_learner_that_repairs_pays_once_and_one_that_trusts_pays_every_visit(registry, seen, unseen):
+    drifted = drift_schedule(stream_of(seen, visits=6), at_visit=3, donor_tasks=unseen)
+
+    def cost(cls):
+        run_ = run(cls(), drifted, registry=registry, plugins=[DriftAliasPlugin()])
+        control = run(cls(), drifted, registry=registry)
+        assert [r.task_id for r in run_.records] == [r.task_id for r in control.records]   # the same schedule
+        return drift_cost(run_.records, control.records, drifted, EnvConfig())
+
+    nothing, repaired, trusted = (cost(cls) for cls in LEARNERS)
+    assert nothing["stale_state_cost"] == 0 and [v["stale_state_cost"] for v in nothing["by_visit"]] == [0, 0, 0]
+    assert [v["stale_state_cost"] for v in repaired["by_visit"]] == [WRONG, 0, 0]
+    assert repaired["n"] == 12 and repaired["tasks"] == 4 and repaired["extra_cost"] == pytest.approx(1 / 3)
+    assert [v["stale_state_cost"] for v in trusted["by_visit"]] == [15 * WRONG, 100, 100]
+    assert [v["visit"] for v in trusted["by_visit"]] == [0, 1, 2] and trusted["solved"][ARM_SWAPPED] == 0
+    assert nothing["stale_state_cost"] < repaired["stale_state_cost"] < trusted["stale_state_cost"]
