rect"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":392,"cache_read_input_tokens":22429,"cache_creation":{"ephemeral_5m_input_tokens":392,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"c638a0ba-dce8-4aa1-ad90-514566d46e0f","uuid":"39d1083c-a1ca-4050-b89b-5f13ad0980e4","request_id":"req_011CdxJRPWdC2cQ6fDEhUrGx"}
