# Run outputs. Trials, transcripts and throwaway config dirs are large and
# machine-specific; the committed record is the run's markdown write-up plus
# rows.jsonl, which the write-up cites.
evals/runs/*/trials/
evals/runs/*/transcripts/
evals/runs/*/cfg/
evals/runs/*/rows/
evals/runs/smoke*/
node_modules/
.DS_Store
